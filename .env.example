# Copy this file to .env for local development, then add your own keys.
DATA_GOV_API_KEY=
GEMINI_API_KEY=
GNANI_API_KEY=

# Optional Gnani voice settings. Defaults are used when these are omitted.
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_HI_VOICE=Nalini
GNANI_EN_VOICE=Kaveri
GNANI_KN_VOICE=Kavin
