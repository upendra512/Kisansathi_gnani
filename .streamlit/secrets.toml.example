# Copy this file to .streamlit/secrets.toml (never commit the real one).
# On Streamlit Community Cloud paste the same lines into App settings → Secrets.
DATA_GOV_API_KEY = "paste-your-data.gov.in-key"
GEMINI_API_KEY = "paste-your-gemini-key"
GNANI_API_KEY = "paste-your-gnani-key"
# GNANI_STT_MODEL = "prisma-v3.0"
# GNANI_TTS_MODEL = "timbre-v2.5"
# GNANI_HI_VOICE = "Nalini"
# GNANI_EN_VOICE = "Kaveri"
# GNANI_KN_VOICE = "Kavin"
# GEMINI_MODEL = ""   # optional — newest available Flash model is auto-detected
